---
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/Search.astro';

const links = [
  { href: '/getting-started/installation', text: 'Get started' },
  { href: '/guides/torch-training', text: 'Guides' },
  { href: '/reference/interface', text: 'Reference' },
];
const topLevel = (pathname: string) => pathname.split('/')[1];
const currentBase = topLevel(Astro.url.pathname);
---

<div class="brand-wrapper hidden lg:flex">
  <a href="/" class="brand-link font-bold text-xl">Extended Einsum</a>
</div>
{links.map(link => (
  <a href={link.href} class={`nav-link max-[800px]:hidden px-4 py-1.5 font-bold ${topLevel(link.href) === currentBase && 'active rounded-md'}`}>
    {link.text}
  </a>
))}
<div style="flex-grow: 1;"></div>
<Default {...Astro.props}><slot /></Default>

<style>
  .brand-wrapper {
    align-items: center;
    margin-inline-end: 2rem;
  }
  .brand-link, .nav-link {
    align-items: center;
    color: var(--sl-color-text);
    display: inline-flex;
    min-height: 2.5rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .active {
    background: var(--ee-active-bg);
    color: var(--ee-active-fg);
  }
</style>
